# Copy to .env and fill in what you need. Every value is optional:
# with nothing set, shiny-pancake runs fully offline with the deterministic demo provider.

# --- LLM backend --------------------------------------------------------------
# anthropic | openai | offline   (default: anthropic if a key is set, else offline)
SP_PROVIDER=
ANTHROPIC_API_KEY=
# Main model (orchestrator, specialists, final summary editor)
SP_MODEL=claude-sonnet-5-5
# Cheaper model for the parallel summary workers (map/reduce steps)
SP_WORKER_MODEL=claude-haiku-5-5
# Optional effort for main / worker calls: low | medium | high | xhigh | max
SP_EFFORT=
SP_WORKER_EFFORT=low
# Server-side refusal fallbacks on models that support them (1/0)
SP_REFUSAL_FALLBACKS=1
# Prompt caching: system prefix + conversation tail (1/0)
SP_PROMPT_CACHE=1

# OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, LiteLLM, OpenAI)
SP_OPENAI_BASE_URL=http://localhost:11434/v1
SP_OPENAI_API_KEY=

# Cross-vendor fallback when the primary provider fails: offline | openai | anthropic
SP_FALLBACK_PROVIDER=

# --- Budgets & resilience -----------------------------------------------------
SP_MAX_STEPS=8
SP_MAX_TOKENS=16000
SP_WORKER_MAX_TOKENS=4096
SP_MAX_RETRIES=2
SP_MAX_CONCURRENCY=8
SP_REQUEST_TIMEOUT=120

# --- Summarization ------------------------------------------------------------
SP_SUMMARY_WORKERS=4
SP_CHUNK_CHARS=6000

# --- Hub ----------------------------------------------------------------------
SP_DATA_DIR=./data
SP_WORKSPACE=./workspace
# Job workers started inside the API process (0 = use separate `shiny-pancake worker` processes)
SP_INLINE_WORKERS=2
# Side-effecting tools (write_file): auto | deny
SP_APPROVAL=auto
# If set, the HTTP API requires `x-api-key: <value>` (or `Authorization: Bearer <value>`)
SP_API_KEY=
